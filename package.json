{
  "name": "sidebery",
  "version": "5.6.1",
  "description": "Manage your tabs and bookmarks in sidebar",
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt -b firefox --mv3",
    "dev:chrome": "wxt -b chrome --mv3",
    "build": "wxt build -b firefox --mv3",
    "build:chrome": "wxt build -b chrome --mv3",
    "zip": "wxt zip -b firefox --mv3",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "clear": "wxt clean",
    "lint.eslint": "eslint ./src",
    "lint.types": "vue-tsc --noemit",
    "lint": "pnpm run lint.eslint && pnpm run lint.types",
    "test": "vitest run",
    "test.watch": "vitest watch"
  },
  "author": "mbnuqw",
  "license": "MIT",
  "packageManager": "pnpm@10.34.4",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/language-plugin-pug": "3.3.11",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "pug": "3.0.4",
    "stylus": "0.64.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11",
    "web-ext": "10.6.0",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "vue": "3.5.42"
  },
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "printWidth": 100,
    "useTabs": false
  },
  "browserslist": [
    "Firefox >= 140"
  ],
  "sideEffects": false
}
